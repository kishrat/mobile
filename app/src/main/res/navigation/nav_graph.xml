<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- Auth Flow -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.eventtracker.ui.auth.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_loginFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.example.eventtracker.ui.auth.SignUpFragment"
        android:label="Sign Up">
        <action
            android:id="@+id/action_signUpFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Main Navigation -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.eventtracker.ui.home.HomeFragment"
        android:label="Events">
        <action
            android:id="@+id/action_homeFragment_to_eventDetailFragment"
            app:destination="@id/eventDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.example.eventtracker.ui.map.MapFragment"
        android:label="Campus Map">
        <action
            android:id="@+id/action_mapFragment_to_eventDetailFragment"
            app:destination="@id/eventDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/accountFragment"
        android:name="com.example.eventtracker.ui.account.AccountFragment"
        android:label="Account">
        <action
            android:id="@+id/action_accountFragment_to_myEventsFragment"
            app:destination="@id/myEventsFragment" />
        <action
            android:id="@+id/action_accountFragment_to_createEventFragment"
            app:destination="@id/createEventFragment" />
        <action
            android:id="@+id/action_accountFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Event Detail -->
    <fragment
        android:id="@+id/eventDetailFragment"
        android:name="com.example.eventtracker.ui.detail.EventDetailFragment"
        android:label="Event Details">
        <argument
            android:name="eventId"
            app:argType="string" />
    </fragment>

    <!-- Create Event -->
    <fragment
        android:id="@+id/createEventFragment"
        android:name="com.example.eventtracker.ui.create.CreateEventFragment"
        android:label="Create Event" />

    <!-- My Events -->
    <fragment
        android:id="@+id/myEventsFragment"
        android:name="com.example.eventtracker.ui.account.MyEventsFragment"
        android:label="My Events">
        <action
            android:id="@+id/action_myEventsFragment_to_eventDetailFragment"
            app:destination="@id/eventDetailFragment" />
    </fragment>

</navigation>