<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Semi-transparent fill -->
    <solid android:color="#66005793" /> <!-- orange with 40% opacity -->

    <!-- Solid border -->
    <stroke
        android:width="2dp"
        android:color="#005793" /> <!-- solid orange border -->

    <!-- Rounded corners -->
    <corners android:radius="8dp" />

    <!-- Optional padding -->
    <padding
        android:left="12dp"
        android:top="8dp"
        android:right="12dp"
        android:bottom="8dp" />
</shape>
