<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fill color -->
    <solid android:color="#FFFFFFFF" /> <!-- white background -->

    <!-- Rounded corners -->
    <corners android:radius="12dp" />

    <!-- Border -->
    <stroke
        android:width="2.5dp"
        android:color="#FF9800" /> <!-- orange border -->

    <!-- Optional inner padding -->
    <padding
        android:left="10dp"
        android:right="10dp"
        android:top="8dp"
        android:bottom="8dp" />
</shape>
