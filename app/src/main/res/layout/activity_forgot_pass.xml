<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDE1D0"
    tools:context=".ForgotPasswordActivity">

    <!-- Logo Circle -->
    <View
        android:id="@+id/LogoCircle"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/circle_shape"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Welcome Text -->
    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Welcome to"
        android:textColor="#000000"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/LogoCircle" />

    <TextView
        android:id="@+id/appNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Event-Tracker."
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/welcomeText" />

    <View
        android:id="@+id/loginBackground"
        android:layout_width="346dp"
        android:layout_height="608dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_box"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.492"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appNameText" />

    <TextView
        android:id="@+id/forgotTitle"
        android:layout_width="221dp"
        android:layout_height="65dp"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/inter_variable"
        android:letterSpacing="0.15"
        android:text="FORGOT
        PASSWORD?"
        android:textColor="#000000"
        android:textSize="27dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/loginBackground"
        app:layout_constraintHorizontal_bias="0.168"
        app:layout_constraintStart_toStartOf="@id/loginBackground"
        app:layout_constraintTop_toTopOf="@id/loginBackground" />

    <TextView
        android:id="@+id/instruction"
        android:layout_width="324dp"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/inter_variable"
        android:text="Enter your email and we’ll send a reset link."
        android:textAlignment="center"
        android:textColor="#333"
        app:layout_constraintEnd_toEndOf="@+id/loginBackground"
        app:layout_constraintStart_toStartOf="@+id/loginBackground"
        app:layout_constraintTop_toBottomOf="@+id/forgotTitle" />

    <EditText
        android:id="@+id/inputResetEmail"
        android:layout_width="305dp"
        android:layout_height="70dp"
        android:layout_marginTop="68dp"
        android:background="@drawable/rounded_input"
        android:hint="Email"
        android:paddingHorizontal="16dp"
        android:textColorHint="#555"
        app:layout_constraintEnd_toEndOf="@+id/loginBackground"
        app:layout_constraintHorizontal_bias="0.512"
        app:layout_constraintStart_toStartOf="@+id/loginBackground"
        app:layout_constraintTop_toBottomOf="@+id/instruction" />

    <Button
        android:id="@+id/sendResetButton"
        android:layout_width="308dp"
        android:layout_height="45dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/login_bt"
        android:fontFamily="@font/inter_variable"
        android:text="Send Reset Link"
        android:textColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="@+id/loginBackground"
        app:layout_constraintStart_toStartOf="@+id/loginBackground"
        app:layout_constraintTop_toBottomOf="@+id/inputResetEmail" />

    <Button
        android:id="@+id/backToLogin"
        android:layout_width="181dp"
        android:layout_height="50dp"
        android:layout_marginTop="92dp"
        android:background="@drawable/signup_bt_bg"
        android:paddingHorizontal="30dp"
        android:paddingVertical="10dp"
        android:text="Back to Login"
        android:textColor="#005793"
        android:textSize="16dp"
        app:layout_constraintEnd_toEndOf="@id/loginBackground"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintStart_toStartOf="@id/loginBackground"
        app:layout_constraintTop_toBottomOf="@+id/sendResetButton" />


</androidx.constraintlayout.widget.ConstraintLayout>
