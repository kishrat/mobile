<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDE1D0"
    tools:context=".MainActivity">

    <!-- Profile Circle -->
    <View
        android:id="@+id/LogoCircle"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/circle_shape"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Welcome Text -->
    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Welcome to"
        android:textColor="#000000"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/LogoCircle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/appNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Event-Tracker."
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="italic"
        app:layout_constraintTop_toBottomOf="@id/welcomeText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Login Background -->
    <View
        android:id="@+id/loginBackground"
        android:layout_width="346dp"
        android:layout_height="608dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/rounded_box"
        app:layout_constraintTop_toBottomOf="@id/appNameText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- LOGIN Title -->

    <TextView
        android:id="@+id/loginTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/inter_variable"
        android:text="L O G I N"
        android:textColor="#000000"
        android:textSize="27dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/loginBackground"
        app:layout_constraintHorizontal_bias="0.101"
        app:layout_constraintStart_toStartOf="@id/loginBackground"
        app:layout_constraintTop_toTopOf="@id/loginBackground" />

    <EditText
        android:id="@+id/email"
        android:layout_width="304dp"
        android:layout_height="79dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="84dp"
        android:background="@drawable/rounded_input"
        android:hint="Email"
        android:inputType="textEmailAddress"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="@id/loginBackground"
        app:layout_constraintStart_toStartOf="@id/loginBackground"
        app:layout_constraintTop_toTopOf="@id/loginBackground" />

    <EditText
        android:id="@+id/password"
        android:layout_width="304dp"
        android:layout_height="79dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_input"
        android:hint="Password"
        android:inputType="textPassword"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="@id/loginBackground"
        app:layout_constraintHorizontal_bias="0.571"
        app:layout_constraintStart_toStartOf="@id/loginBackground"
        app:layout_constraintTop_toBottomOf="@id/email" />

    <TextView
        android:id="@+id/forgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:text="forgot password?"
        android:textColor="#0000EE"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/loginBackground"
        app:layout_constraintTop_toBottomOf="@+id/password" />

    <Button
        android:id="@+id/loginButton"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/login_bt"
        android:text="LOGIN"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="23dp"
        app:layout_constraintEnd_toEndOf="@id/loginBackground"
        app:layout_constraintStart_toStartOf="@id/loginBackground"
        app:layout_constraintTop_toBottomOf="@+id/forgotPassword" />

    <TextView
        android:id="@+id/firstVisit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:text="First Visit?"
        android:fontFamily="@font/inter_variable"
        android:textColor="#000000"
        android:textSize="20dp"
        app:layout_constraintEnd_toEndOf="@id/loginBackground"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="@id/loginBackground"
        app:layout_constraintTop_toBottomOf="@id/loginButton" />

    <Button
        android:id="@+id/signUpButton"
        android:layout_width="181dp"
        android:layout_height="50dp"
        android:layout_marginBottom="56dp"
        android:background="@drawable/signup_bt_bg"
        android:paddingHorizontal="30dp"
        android:paddingVertical="10dp"
        android:text="SIGN UP"
        android:textColor="#005793"
        android:textSize="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/loginBackground"
        app:layout_constraintEnd_toEndOf="@id/loginBackground"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="@id/loginBackground" />

</androidx.constraintlayout.widget.ConstraintLayout>
